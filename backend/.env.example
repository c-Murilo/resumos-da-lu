GEMINI_API_KEY=cole_sua_chave_aqui
# GEMINI_MODEL=  # modelo padrão; vazio = o mais recente que a chave oferecer
#GEMINI_MODEL=gemini-2.5-flash
PLAUD_MCP_COMMAND=npx
PLAUD_MCP_ARGS=-y @plaud-ai/mcp@latest
# FRONTEND_ORIGIN=  # vazio em dev = qualquer localhost; em produção, o domínio real
PROMPT_FILE=prompt.md
# GEMINI_MODELS=  # opcional: restringe o seletor a esta lista
#GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
# GEMINI_MAX_OUTPUT_TOKENS=  # opcional: teto de saída, para aulas longas
MONGODB_URI=  # connection string do Atlas (mongodb+srv://...)
MONGODB_DB=resumos_da_lu
AUTO_RESUMO=0
AUTO_RESUMO_INTERVALO=300
# GEMINI_FALLBACK=gemini-3.5-flash  # modelos reserva, em ordem
# AUDIO_BLOCO_MINUTOS=40  # tamanho do bloco para aulas longas
